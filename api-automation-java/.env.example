# Base URL for OrangeHRM (no trailing slash recommended)
BASE_URL=https://opensource-demo.orangehrmlive.com

# OrangeHRM API base path (v2 APIs used by most modules)
API_BASE_PATH=/api/v2

# Credentials (placeholders - replace locally / in CI secrets)
ADMIN_USERNAME=__ADMIN_USERNAME__
ADMIN_PASSWORD=__ADMIN_PASSWORD__

ESS_USERNAME=__ESS_USERNAME__
ESS_PASSWORD=__ESS_PASSWORD__

# Base URL for OrangeHRM (no trailing slash recommended)
BASE_URL=https://opensource-demo.orangehrmlive.com

# OrangeHRM API base path (v2 APIs used by most modules)
API_BASE_PATH=/api/v2

# Stable demo credentials (public demo defaults)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# Optional secondary user (not required for demo run)
ESS_USERNAME=Admin
ESS_PASSWORD=admin123

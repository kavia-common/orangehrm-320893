<?xml version="1.0" encoding="UTF-8"?>
<!--
  Java (JUnit 5) Selenium skeleton for OrangeHRM.

  IMPORTANT:
  - This module is designed for "discovery-only validation" by default.
  - It MUST NOT launch a real browser unless explicitly enabled.

  Usage:
    mvn -q test
  To enable real browser usage intentionally:
    mvn -q test -Dorangehrm.discoveryOnly=false
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.orangehrm</groupId>
  <artifactId>orangehrm-selenium-junit</artifactId>
  <version>1.0.0</version>
  <name>orangehrm-selenium-junit</name>
  <description>Java + JUnit Selenium UI automation skeleton for OrangeHRM (discovery-only by default).</description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Keep these modern but not overly strict; can be pinned later if needed -->
    <junit.jupiter.version>5.10.2</junit.jupiter.version>
    <!-- Keep JUnit Platform aligned with JUnit Jupiter to ensure suite annotations are available -->
    <junit.platform.version>1.10.2</junit.platform.version>
    <selenium.version>4.18.1</selenium.version>
    <slf4j.version>2.0.12</slf4j.version>

    <!-- Allure reporting -->
    <allure.version>2.27.0</allure.version>

    <!-- Cucumber BDD -->
    <cucumber.version>7.15.0</cucumber.version>

    <!-- Default behavior: NO real browser -->
    <orangehrm.discoveryOnly>true</orangehrm.discoveryOnly>

    <!-- Default behavior: validate step bindings without executing browser logic -->
    <cucumber.dryRun>true</cucumber.dryRun>
  </properties>

  <dependencies>
    <!-- JUnit 5 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.jupiter.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- JUnit Platform Suite API (required for org.junit.platform.suite.api annotations) -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite-api</artifactId>
      <version>${junit.platform.version}</version>
      <scope>test</scope>
    </dependency>

    <!--
      JUnit Platform Suite Engine (required at runtime so @Suite-based classes are discoverable/executable).
      Without this, Surefire/JUnitPlatformProvider will report "Tests run: 0" even if the suite compiles.
    -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-suite-engine</artifactId>
      <version>${junit.platform.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Cucumber (JUnit Platform Engine) -->
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-java</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.cucumber</groupId>
      <artifactId>cucumber-junit-platform-engine</artifactId>
      <version>${cucumber.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Allure JUnit 5 integration (writes allure-results during test execution) -->
    <dependency>
      <groupId>io.qameta.allure</groupId>
      <artifactId>allure-junit5</artifactId>
      <version>${allure.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Selenium API -->
    <dependency>
      <groupId>org.seleniumhq.selenium</groupId>
      <artifactId>selenium-java</artifactId>
      <version>${selenium.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- Simple logging (used only if real mode is enabled) -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>${slf4j.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- API automation -->
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>rest-assured</artifactId>
      <version>5.4.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.rest-assured</groupId>
      <artifactId>json-path</artifactId>
      <version>5.4.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.skyscreamer</groupId>
      <artifactId>jsonassert</artifactId>
      <version>1.5.1</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Force modern Java compilation for test sources.
        Without this, some Maven/JDK combos default to -source/-target 5 and fail on modern JDKs.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <encoding>${project.build.sourceEncoding}</encoding>
        </configuration>
      </plugin>

      <!-- Ensure JUnit 5 discovery/execution works in Maven test phase -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>

          <!-- Pass discovery-only + cucumber flags to tests -->
          <systemPropertyVariables>
            <orangehrm.discoveryOnly>${orangehrm.discoveryOnly}</orangehrm.discoveryOnly>

            <!-- Cucumber: dry-run validates bindings without executing step code -->
            <cucumber.dryRun>${cucumber.dryRun}</cucumber.dryRun>

            <!-- Allure: where to write raw results -->
            <allure.results.directory>${project.basedir}/allure-results</allure.results.directory>
          </systemPropertyVariables>

          <!-- Make sure Surefire uses JUnit Platform (needed for cucumber-junit-platform-engine) -->
          <properties>
            <configurationParameters>
              cucumber.execution.dry-run=${cucumber.dryRun}
            </configurationParameters>
          </properties>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

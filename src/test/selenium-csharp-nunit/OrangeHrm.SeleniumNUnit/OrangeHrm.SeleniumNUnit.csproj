<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      IMPORTANT:
      This project is designed for "discovery-only validation" by default.
      It MUST NOT launch a real browser unless explicitly enabled.

      Default:
        OrangeHrmDiscoveryOnly=true

      To enable real browser mode intentionally:
        dotnet test -p:OrangeHrmDiscoveryOnly=false
    -->
    <OrangeHrmDiscoveryOnly Condition="'$(OrangeHrmDiscoveryOnly)'==''">true</OrangeHrmDiscoveryOnly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.18.1" />
    <PackageReference Include="Selenium.Support" Version="4.18.1" />
  </ItemGroup>

</Project>

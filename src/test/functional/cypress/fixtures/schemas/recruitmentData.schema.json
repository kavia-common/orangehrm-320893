{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrangeHRM Cypress Data - Recruitment",
  "type": "object",
  "additionalProperties": false,
  "required": ["recruitmentTests"],
  "properties": {
    "recruitmentTests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "testCaseId",
          "vacancyName",
          "candidateFirstName",
          "candidateLastName",
          "email",
          "status"
        ],
        "properties": {
          "testCaseId": {"type": "string", "minLength": 1},
          "vacancyName": {"type": "string", "minLength": 1},
          "candidateFirstName": {"type": "string", "minLength": 1},
          "candidateLastName": {"type": "string", "minLength": 1},
          "email": {"type": "string"},
          "status": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrangeHRM Cypress Data - Dashboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["dashboardTests"],
  "properties": {
    "dashboardTests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["testCaseId", "widgetName", "expectedVisible"],
        "properties": {
          "testCaseId": {"type": "string", "minLength": 1},
          "widgetName": {"type": "string", "minLength": 1},
          "expectedVisible": {"type": "boolean"}
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrangeHRM Cypress Data - API Tests",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiTests"],
  "properties": {
    "apiTests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "testCaseId",
          "endpoint",
          "method",
          "payload",
          "expectedStatusCode"
        ],
        "properties": {
          "testCaseId": {"type": "string", "minLength": 1},
          "endpoint": {"type": "string", "minLength": 1},
          "method": {"type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
          "payload": {"type": "object"},
          "expectedStatusCode": {"type": "integer", "minimum": 100, "maximum": 599}
        }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OrangeHRM Cypress Data - Leave",
  "type": "object",
  "additionalProperties": false,
  "required": ["leaveTests"],
  "properties": {
    "leaveTests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "testCaseId",
          "employeeName",
          "leaveType",
          "fromDate",
          "toDate",
          "expectedStatus"
        ],
        "properties": {
          "testCaseId": {"type": "string", "minLength": 1},
          "employeeName": {"type": "string", "minLength": 1},
          "leaveType": {"type": "string", "minLength": 1},
          "fromDate": {"type": "string", "format": "date"},
          "toDate": {"type": "string", "format": "date"},
          "expectedStatus": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}

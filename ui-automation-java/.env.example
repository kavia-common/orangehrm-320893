# OrangeHRM Demo UI automation configuration (Java)
# Copy to .env and fill with real values. Do NOT commit .env

BASE_URL=https://opensource-demo.orangehrmlive.com

# Stable test accounts (placeholders; set actual values in .env)
ADMIN_USERNAME=__ADMIN_USERNAME__
ADMIN_PASSWORD=__ADMIN_PASSWORD__

ESS_USERNAME=__ESS_USERNAME__
ESS_PASSWORD=__ESS_PASSWORD__

# Optional: default browser if not passed as -Dbrowser=...
BROWSER=chrome

# Optional: headless mode (true/false)
HEADLESS=false

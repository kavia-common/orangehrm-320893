# OrangeHRM Demo UI automation configuration (Java)
# Copy to .env if you want to override values. For demo usage, these defaults are stable.

# Public OrangeHRM demo site
BASE_URL=https://opensource-demo.orangehrmlive.com

# Stable demo credentials (public demo defaults)
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# Optional secondary user (not required for the demo run)
ESS_USERNAME=Admin
ESS_PASSWORD=admin123

# Optional: default browser if not passed as -Dbrowser=...
BROWSER=chrome

# Optional: headless mode (true/false)
HEADLESS=false

# Optional: explicit Chrome/Chromium binary path (useful in containers)
# Example:
# CHROME_BINARY=/usr/bin/google-chrome
CHROME_BINARY=
